{
  "name": "nordic",
  "version": "1.0.0",
  "description": "Minimalisticki sajt za iznajmljivanje kamper kucica",
  "license": "ISC",
  "author": "Iveta",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "devserver": "live-server",
    "watch:sass": "sass sass/main.scss css/style.css --watch",
    "start": "npm-run-all --parallel devserver watch:sass",
    "compile:sass": "sass sass/main.scss css/style.css",
    "build": "sass sass/main.scss css/style.css --style compressed"
  },
  "devDependencies": {
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "sass": "^1.85.0"
  }
}
